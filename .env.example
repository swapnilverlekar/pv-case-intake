# Copy to .env and fill in. .env is gitignored.

# Anthropic: every model call (agent, baseline, LLM judge)
ANTHROPIC_API_KEY=

# LangSmith: tracing, the eval dataset, experiments
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pv-case-intake
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# openFDA: only needed to rebuild the dataset (AE_Data/pull_faers.py); free key at open.fda.gov
OPENFDA_API_KEY=
